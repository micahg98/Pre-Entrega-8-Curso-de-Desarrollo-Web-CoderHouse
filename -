body {
  color: #263238;
  font-family: "Trebuchet MS", sans-serif;
  line-height: 1.6;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: Georgia, serif;
  line-height: 1.2;
}

html {
  box-sizing: border-box;
  scroll-behavior: smooth;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  background-color: #f7f4ef;
}

img {
  max-width: 100%;
  height: auto;
}

header {
  background-color: #1f4e5f;
  color: #ffffff;
  padding: 1rem;
}

footer {
  background-color: #1f4e5f;
  color: #ffffff;
  padding: 1.5rem 1rem;
  text-align: center;
}

nav a {
  color: inherit;
  text-decoration: none;
}

nav a:hover,
nav a:focus-visible {
  color: #f2a365;
}

button,
.button {
  border: 0;
  border-radius: 4px;
  background-color: #f2a365;
  color: #263238;
  cursor: pointer;
  padding: 0.65rem 1rem;
}

button:hover,
.button:hover,
button:focus-visible,
.button:focus-visible {
  background-color: #1f4e5f;
  color: #ffffff;
}

button:focus-visible,
.button:focus-visible {
  outline: 3px solid rgba(242, 163, 101, 0.5);
  outline-offset: 2px;
}

.card {
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 14px rgba(38, 50, 56, 0.12);
  padding: 1rem;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.card:hover,
.card:focus-within {
  box-shadow: 0 8px 20px rgba(38, 50, 56, 0.18);
  transform: translateY(-2px);
}
